# Copy this file to .env and fill in your own free API key.
# Any OpenAI-compatible provider works. Check your provider's docs for the current model names.

# Option A: Groq
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=pick-a-tool-calling-model-from-groq-docs

# Option B: Google Gemini (comment out Option A and use these instead)
# LLM_API_KEY=your_gemini_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=pick-a-gemini-model-from-google-docs
